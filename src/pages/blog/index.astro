---
import BlogIndex from '../../layouts/BlogIndex.astro';
import { getCollection } from 'astro:content';
import { pairs } from '../../i18n/ui';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<BlogIndex
  lang="de"
  title="Blog — Traumtheater"
  description="Artikel über Traumdeutung nach der Aisling-Methode: was Träume bedeuten, wie du sie erinnerst und was sie über deine Lebenssituation sagen."
  path="/blog"
  alternates={pairs.blog}
  heading="Blog"
  intro="Gedanken zur Traumdeutung nach der Aisling-Methode: praktisch, ohne Fachjargon, für alle, die ihre Träume ernst nehmen möchten."
  posts={posts}
  postBase="/blog"
/>
