---
import Base from '../layouts/Base.astro';
import CtaButtons from '../components/CtaButtons.astro';

const title = 'Traumtheater — Persönliche Traumdeutung nach der Aisling-Methode';
const description =
  'Persönliche, schriftliche Traumdeutung nach der Aisling-Methode — fundiert und spirituell, ohne esoterische Überfrachtung. Ausführlich und nachvollziehbar, auf Deutsch oder Englisch, für Deutschland, Österreich und die Schweiz.';

const benefits = [
  ['♥', 'Gesundheit', 'Träume zeigen den Zustand deines Körpers oft Jahre vor dem Auftreten von Symptomen. Frühwarnsystem und Heilungshinweis in einem.'],
  ['◈', 'Richtung', 'Wo stehst du in deiner Entwicklung? Welcher nächste Schritt wäre jetzt richtig für dich? Dein Traum weiß es bereits.'],
  ['⟳', 'Muster', 'Wiederkehrende Träume zeigen wiederkehrende Blockaden. Was sich wiederholt, sucht Auflösung.'],
  ['✦', 'Beziehungen', 'Jede Person in deinem Traum ist ein Aspekt von dir. Was dir an ihnen auffällt, sagt mehr über dich als über sie.'],
  ['◉', 'Verborgene Gaben', 'Träume kennen deine Stärken besser als du. Sie zeigen Fähigkeiten und Potenziale, die du noch nicht nutzt.'],
  ['☽', 'Vorbereitung', 'Manchmal bereiten Träume dich auf kommende Ereignisse vor — als Einladung, dich rechtzeitig zu öffnen oder zu schützen.'],
];

const symbols = [
  ['Wasser', 'Dein geistiges Leben. Klares Wasser: Verbindung. Trübes Wasser: Unterbrechung. Die Tiefe zeigt die Tiefe deiner Seele.'],
  ['Feuer', 'Deine Emotionen und dein Herzkreislaufsystem. Unkontrolliertes Feuer: Erschöpfung. Ruhiges Feuer: Leidenschaft in Balance.'],
  ['Haus', 'Dein Körper. Jeder Raum entspricht einem Bereich: Keller = Unterbewusstes, Dach = Geist, Küche = Verdauung.'],
  ['Fliegen', 'Geistige Erhebung über Probleme. Du steigst über eine Situation hinaus — oder möchtest es tun. Ein sehr gutes Zeichen.'],
  ['Lehrer', 'Du bist spirituelle Lehrerin. Ein Lehrer im Traum zeigt deine Berufung, andere auf ihrem Weg zu führen.'],
  ['Schlange', 'Heilung oder Verführung — der Kontext entscheidet. Im Garten: alte Muster. Als Helfer: Heilkraft.'],
  ['Brücke', 'Übergang zwischen zwei Phasen. Du stehst vor oder mitten in einer wichtigen Veränderung deines Lebens.'],
  ['Garten', 'Öffentlicher Ausdruck deiner Gaben. Was blüht: Talente zum Teilen. Was verborgen liegt: wartet auf Pflege.'],
];

const timeline = [
  ['1990er', 'George Rhatigan entwickelt das Grundgerüst der Aisling-Methode in Irland. Die erste systematische Sammlung von Traumsymbolen entsteht aus gelebter Beratungspraxis.'],
  ['1997', 'Michael Sheridan veröffentlicht How to Interpret Your Dreams and Discover Your Life Purpose — das erste dokumentierte Werk der Methode.'],
  ['2000er', 'Sheridan wird regelmäßiger Gast bei Ireland AM, BBC und Seattle Radio KKNW. Die Methode verbreitet sich international in mehrere Sprachen.'],
  ['2015', 'Michael kündigt seine Stelle als Softwareentwickler und widmet sich fortan ganz der Aisling School of Dream Interpretation, die er ins Internet bringt. Die Radiosendung startet, und Sandy hilft im Hintergrund beim Wachstum der Schule.'],
  ['2016', 'Der Dream Interpretation Podcast mit Michael Sheridan ist eine wöchentliche halbstündige Sendung darüber, wie deine nächtlichen Träume dich für die wichtigen Themen in deinem Leben wachrütteln. Bis heute wurden 365 Folgen aufgenommen.'],
  ['Heute', 'Hunderte zertifizierter Praktiker weltweit. Ein Symbolbuch mit über 3.000 verifizierten Einträgen. Klienten, die sich selbst erkennen.'],
];

const testimonials = [
  ['Monika Dziatkiewicz', '„Hallo Mark. Ich habe deine E-Mail drei Mal gelesen und ins Polnische übersetzt — wow! Meine Güte. Vielen, vielen Dank!!!!!!! Es ist eine unglaubliche Deutung.“'],
  ['Ciara Clarke', '„Mark hat die Träume entschlüsselt, die in einer sehr stressigen Zeit zu mir kamen. Seine einfühlsamen und gekonnten Interpretationen gaben mir die Klarheit, Orientierung, das Verständnis und die Erleichterung, auf die mich meine Träume hinweisen wollten. Ich würde jedem, der die Botschaften in seinen eigenen Träumen verstehen möchte, Marks sehr hilfreiche Dienste wärmstens empfehlen.“'],
  ['Nicky E.', '„Marks Deutungen für mich und meinen 10-jährigen Sohn waren einfühlsam, präzise und stimmten vollkommen mit realen Lebenserfahrungen überein. Ich bin dankbar für sein Wissen, seine ausführlichen Antworten und die Sorgfalt, mit der er mit Menschen über ihre Träume spricht.“'],
  ['Lisa M.', '„Mark hat mir bereits mehrere meiner Träume interpretiert. Meist fand ich sie beim Aufwachen selbst nur verwirrend, zum Teil beängstigend. Durch Marks Übersetzungen wurden dann aber die Botschaften klar. Sie waren wunderschön. Deutlich. Liebevoll.“'],
  ['Sonja', '„Die Traumdeutung von Mark hat mich unerwartet sehr berührt. Ich hatte nicht erwartet, dass in den für uns oft so unsinnigen Träumen doch soviel Weisheit und Wahrheit steckt und sie mir soviel geben können. Vielen Dank, lieber Mark, für deine wertvolle Arbeit.“'],
];

const site = 'https://traum-theater.de';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@graph': [
      {
        '@type': 'Person',
        '@id': `${site}/#person`,
        name: 'Mark Anthony Irwin',
        givenName: 'Mark',
        familyName: 'Irwin',
        jobTitle: 'Traumdeuter',
        description:
          'Zertifizierter Traumdeuter nach der Aisling-Methode. Arbeitet seit 2011 mit Träumen; persönliche, schriftliche Traumdeutungen auf Deutsch und Englisch.',
        image: `${site}/assets/mark-portrait.png`,
        url: site + '/',
        email: 'mark@traum-theater.de',
        telephone: '+4915150317725',
        knowsLanguage: ['de', 'en'],
        hasCredential: [
          {
            '@type': 'EducationalOccupationalCredential',
            credentialCategory: 'certification',
            name: 'Aisling School Channel',
            dateCreated: '2024-12',
            recognizedBy: { '@type': 'Organization', name: 'Aisling School' },
          },
          {
            '@type': 'EducationalOccupationalCredential',
            credentialCategory: 'certification',
            name: 'Aisling-Method — Certified Dream Interpreter',
            dateCreated: '2026-04',
            recognizedBy: { '@type': 'Organization', name: 'Aisling School' },
          },
        ],
        sameAs: ['https://www.provenexpert.com/mark-anthony-irwin/'],
        worksFor: { '@id': `${site}/#business` },
      },
      {
        '@type': 'ProfessionalService',
        '@id': `${site}/#business`,
        name: 'Traumtheater',
        alternateName: 'Traumtheater — Persönliche Traumdeutung',
        description:
          'Persönliche, schriftliche Traumdeutung nach der Aisling-Methode. Fundiert und spirituell zugleich, ohne esoterische Überfrachtung: eine ausführliche Deutung, deren Herleitung nachvollziehbar bleibt und die Traum, Kontext und Lebenssituation des Klienten ernst nimmt.',
        image: `${site}/assets/logo.png`,
        url: site + '/',
        address: {
          '@type': 'PostalAddress',
          streetAddress: 'Parkstraße 15',
          addressLocality: 'Kempen',
          postalCode: '47906',
          addressCountry: 'DE',
        },
        // Business/legal contact. Client communication goes to mark@ (Person node).
        email: 'kontakt@traum-theater.de',
        telephone: '+4915150317725',
        priceRange: '€29',
        founder: { '@id': `${site}/#person` },
        employee: { '@id': `${site}/#person` },
        areaServed: [
          { '@type': 'Country', name: 'Germany' },
          { '@type': 'Country', name: 'Austria' },
          { '@type': 'Country', name: 'Switzerland' },
        ],
        availableLanguage: ['de', 'en'],
        makesOffer: {
          '@type': 'Offer',
          itemOffered: {
            '@type': 'Service',
            name: 'Persönliche schriftliche Traumdeutung',
            serviceType: 'Dream interpretation',
            provider: { '@id': `${site}/#person` },
          },
          price: '29.00',
          priceCurrency: 'EUR',
          description: 'Einführungsangebot (regulärer Preis 69 €). §19 UStG — keine Umsatzsteuer.',
          availability: 'https://schema.org/InStock',
          url: `${site}/#angebot`,
        },
        review: testimonials.slice(0, 3).map(([name, body]) => ({
          '@type': 'Review',
          author: { '@type': 'Person', name },
          reviewRating: { '@type': 'Rating', ratingValue: '5', bestRating: '5' },
          reviewBody: body.replace(/[„“]/g, ''),
        })),
        aggregateRating: {
          '@type': 'AggregateRating',
          ratingValue: '5',
          reviewCount: '12',
          bestRating: '5',
        },
      },
    ],
  },
];
---

<Base title={title} description={description} path="/" jsonLd={jsonLd}>
  {/* ══════════ HERO — banner kept, wordmark in Uncial ══════════ */}
  <header class="tt-hero">
    <div class="tt-hero-logo-wrap">
      <img src="/assets/logo.png" alt="Traumtheater — persönliche Traumdeutung (keltischer Steinkreis)" />
    </div>
    <div class="tt-hero-text">
      <div class="tt-eyebrow">Persönliche Traumdeutung</div>
      <div class="tt-site-title">Traum<span class="tt-accent">theater</span></div>
      <h1 class="tt-tagline">Deine Träume, persönlich gedeutet</h1>
    </div>
  </header>

  {/* ══════════ TRUST BLOCK — a real, qualified human before any poetry ══════════ */}
  <section class="tt-trustcard" aria-label="Über den Traumdeuter">
    <div class="tt-trustcard-aside">
      <img
        class="tt-trustcard-portrait"
        src="/assets/mark-portrait.png"
        alt="Mark Anthony Irwin, zertifizierter Traumdeuter nach der Aisling-Methode"
        width="180"
        height="180"
      />
      <a
        class="tt-trustcard-proof"
        href="https://www.provenexpert.com/mark-anthony-irwin/"
        target="_blank"
        rel="noopener noreferrer">
        <img src="/assets/ProvenExpert-Bewertungssiegel.png" alt="ProvenExpert Bewertungssiegel" />
        <span>
          <strong>12 Fünf-Sterne-Bewertungen</strong><br />
          Unabhängig geprüft auf ProvenExpert ↗
        </span>
      </a>
    </div>
    <div class="tt-trustcard-text">
      <p class="tt-trustcard-hello">Hallo, mein Name ist Mark Irwin.</p>
      <p class="tt-trustcard-cred">
        Ich bin 47 und zertifizierter Traumdeuter nach der Aisling-Methode — einer
        irischen Tradition, die seit den 1990er-Jahren gewachsen ist und heute
        weltweit von mehreren hundert zertifizierten Praktikern angewendet wird.
        Seit 2011 arbeite ich mit Träumen, auf Deutsch und Englisch, für
        Klientinnen und Klienten in Deutschland, Österreich und der Schweiz.
      </p>
      <p class="tt-trustcard-what">
        Fundiert und spirituell zugleich, ohne esoterische Überfrachtung. Du
        bekommst keine allgemeinen Sätze, die auf jeden passen, sondern eine
        ausführliche schriftliche Deutung, deren Herleitung du Schritt für
        Schritt nachvollziehen kannst.
      </p>
    </div>
  </section>

  <div class="tt-hero-cta-wrap">
    <CtaButtons tone="light" center={true} />
    <p class="tt-cta-subline">Vertraulich · Persönlich · Schriftlich</p>
  </div>

  <div class="tt-rune-divider"><span class="tt-runes">᚛ ✦ ᚜</span></div>

  {/* ══════════ OPENING ══════════ */}
  <div class="tt-content-block tt-narrow">
    <p class="tt-opening-text">
      <span class="tt-drop-cap">J</span>ede Nacht verlässt deine Seele deinen Körper.
      Sie trifft sich mit deinen Führern auf der astralen Ebene und bespricht, wo du
      in deiner Entwicklung stehst — und was du als Nächstes brauchst. Dann kehrt sie
      zurück und hinterlässt dir eine Botschaft in der einzigen Sprache, die dein
      höheres Selbst spricht: die Sprache der Träume. Die Frage ist nicht, <em>ob</em>
      deine Träume dir etwas sagen wollen. Die Frage ist, ob du sie lesen kannst.
    </p>
  </div>

  {/* ══════════ ARCHETYPES ══════════ */}
  <section class="tt-panel-aged">
    <div style="max-width: 1140px; margin: 0 auto;">
      <p class="tt-sec-label">Erkennst du dich?</p>
      <h2 class="tt-sec-heading">Drei Träumer — ein Bedürfnis</h2>
      <p class="tt-sec-sub">Die meisten meiner Klienten kommen mit einem dieser Gefühle</p>
      <div class="tt-grid-3">
        <div class="tt-card">
          <span class="tt-card-symbol">🌒</span>
          <h3>Der Wiederkehrende Traum</h3>
          <p>Derselbe Traum seit Jahren, manchmal Jahrzehnten. Du weißt, dass er etwas bedeutet. Du hast nur noch nie Antworten bekommen, die sich wirklich richtig anfühlten.</p>
        </div>
        <div class="tt-card">
          <span class="tt-card-symbol">🔮</span>
          <h3>Der Intensive Traum</h3>
          <p>Du bist aufgewacht mit dem Gefühl: das war kein gewöhnlicher Traum. Die Bilder lassen dich nicht los. Irgendetwas Wichtiges war darin — aber was?</p>
        </div>
        <div class="tt-card">
          <span class="tt-card-symbol">🌿</span>
          <h3>Die Suchende</h3>
          <p>Du glaubst, dass deine Träume mehr wissen als du. Du möchtest die Sprache lernen — nicht für einen einzigen Traum, sondern als Schlüssel zu deinem Leben.</p>
        </div>
      </div>
    </div>
  </section>

  {/* ══════════ PROMISE ══════════ */}
  <section class="tt-panel-dark">
    <div style="max-width: 1100px; margin: 0 auto;">
      <p class="tt-sec-label">Mein Versprechen</p>
      <h2 class="tt-sec-heading">Was eine Deutung leistet</h2>
      <p class="tt-sec-sub">Drei Dinge, die ich dir zusichern kann</p>
      <div class="tt-promise-grid">
        <div class="tt-promise-item">
          <span class="tt-promise-numeral">I</span>
          <h3>Die Botschaft ist echt</h3>
          <p>Keine allgemeinen Symboltabellen. Eine Deutung, die deine Geschichte kennt und dir persönlich antwortet.</p>
        </div>
        <div class="tt-promise-item">
          <span class="tt-promise-numeral">II</span>
          <h3>Die Methode ist bewährt</h3>
          <p>Drei Jahrzehnte gelebter Praxis innerhalb der Aisling-Schule. Hunderte zertifizierter Praktiker weltweit haben damit gearbeitet.</p>
        </div>
        <div class="tt-promise-item">
          <span class="tt-promise-numeral">III</span>
          <h3>Die Wahrheit gehört dir</h3>
          <p>Du erkennst deine Deutung — oder du erkennst sie nicht. Das ist das einzige Maß, das zählt. Nie Überredung, nur Erkenntnis.</p>
        </div>
      </div>
    </div>
  </section>

  {/* ══════════ BENEFITS ══════════ */}
  <section class="tt-panel-aged" id="methode">
    <div style="max-width: 1140px; margin: 0 auto;">
      <p class="tt-sec-label">Was Träume aufdecken</p>
      <h2 class="tt-sec-heading">Sechs Bereiche, die dein Traum kommentiert</h2>
      <p class="tt-sec-sub">Deine Träume sind präziser als du denkst</p>
      <div class="tt-grid-2x3">
        {benefits.map(([icon, heading, body]) => (
          <div class="tt-benefit">
            <span class="tt-benefit-icon">{icon}</span>
            <div><h4>{heading}</h4><p>{body}</p></div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <div class="tt-rune-divider"><span class="tt-runes">᚛ ◆ ᚜</span></div>

  {/* ══════════ SYMBOL DICTIONARY ══════════ */}
  <div class="tt-content-block" id="symbole">
    <p class="tt-sec-label">Aus dem Symbolbuch</p>
    <h2 class="tt-sec-heading" style="text-align: center;">Was Symbole bedeuten</h2>
    <p class="tt-sec-sub">Acht Symbole — was die Aisling-Methode darin sieht</p>
    <div class="tt-dict-grid">
      {symbols.map(([word, meaning]) => (
        <div class="tt-dict-card">
          <div class="tt-dict-word">{word}</div>
          <div class="tt-dict-meaning">{meaning}</div>
        </div>
      ))}
    </div>
    <p style="text-align: center; margin-top: 1.5rem; font-style: italic; color: var(--ink-mid);">
      Das Aisling-Symbolbuch enthält über 3.000 Einträge — entwickelt aus drei Jahrzehnten gelebter Praxis.
    </p>
  </div>

  {/* ══════════ PROCESS ══════════ */}
  <section class="tt-panel-aged">
    <div style="max-width: 1100px; margin: 0 auto;">
      <p class="tt-sec-label">So läuft es ab</p>
      <h2 class="tt-sec-heading">Vier Schritte</h2>
      <p class="tt-sec-sub">Klar, persönlich, diskret</p>
      <div class="tt-process-row">
        <div class="tt-process-step">
          <div class="tt-step-ring">i</div>
          <h4>Kontakt aufnehmen</h4>
          <p>Melde dich per WhatsApp oder E-Mail. Erzähl mir kurz, worum es geht — noch nicht den ganzen Traum.</p>
          <p class="tt-step-detail">Ganz unverbindlich, ganz wie du magst.</p>
        </div>
        <div class="tt-process-step">
          <div class="tt-step-ring">ii</div>
          <h4>Ablauf &amp; Zahlung</h4>
          <p>Ich erkläre dir den Ablauf. Du bestätigst kurz die Einwilligung und zahlst den Einführungspreis sicher über einen Zahlungslink.</p>
        </div>
        <div class="tt-process-step">
          <div class="tt-step-ring">iii</div>
          <h4>Traum senden</h4>
          <p>Jetzt schickst du mir deinen Traum — mit Titel und so viel Kontext wie möglich zu deiner aktuellen Lebenssituation.</p>
        </div>
        <div class="tt-process-step">
          <div class="tt-step-ring">iv</div>
          <h4>Deutung erhalten</h4>
          <p>Du erhältst deine Deutung schriftlich. Durchdacht, klar, mit konkretem Bezug zu deinem Leben — du liest und erkennst selbst, ob es stimmt.</p>
        </div>
      </div>
    </div>
  </section>

  {/* ══════════ WHAT YOU RECEIVE ══════════ */}
  <section>
    <div style="max-width: 900px; margin: 0 auto; padding: 4rem 1.5rem;">
      <p class="tt-sec-label">Das Dokument</p>
      <h2 class="tt-sec-heading">Was du erhältst</h2>
      <p class="tt-sec-sub">Drei bis fünf Seiten, sorgfältig strukturiert</p>
      <p class="tt-receive-body">
        Deine Deutung ist ein schriftliches Dokument, das ich für deinen Traum verfasse
        — drei bis fünf Seiten, in deutscher Sprache, nach der Aisling-Methode aufgebaut.
        Kein Chat-Output, keine generische Symboltabelle. Ein Dokument, das du behältst
        und auf das du immer wieder zurückkommen kannst.
      </p>
      <p class="tt-receive-body tt-receive-body-lead"><strong>Im Dokument findest du:</strong></p>
      <ol class="tt-receive-list">
        <li><strong>Dein Traum mit Kontext.</strong> Der Wortlaut deines Traums und die Lebenssituation, aus der er entstanden ist.</li>
        <li><strong>Eine kurze Einführung in die Methode.</strong> Das Subject Matter deines Traums und die I AM / I NEED Formel, damit du verstehst, wie ich lese.</li>
        <li><strong>Eine Deutung Zeile für Zeile.</strong> Was dein Traum dir konkret sagt — persönlich, erkundend, ohne Fachjargon.</li>
        <li><strong>Symbole, Farben, Orte und Zahlen.</strong> Was die Aisling-Tradition in den Bildern deines Traums sieht.</li>
        <li><strong>Eine abschließende Reflexion.</strong> Der Kern deines Traums in einem Bild. Bei dunklen Träumen behutsam eingeordnet — mit Fokus auf die Botschaft, nicht die Angst.</li>
        <li><strong>Konkrete Handlungsvorschläge.</strong> Was dein Traum dich einlädt zu tun, und nächste Schritte.</li>
        <li><strong>Verbindung zu früheren Träumen.</strong> Wenn du schon einmal eingesandt hast, beziehe ich mich auf das, was deine Traumlinie zeigt.</li>
      </ol>
    </div>
  </section>

  {/* ══════════ TRUST STRIP ══════════ */}
  <div class="tt-trust">
    <div class="tt-trust-inner">
      <span>✦ Zertifizierter Aisling-Praktiker</span>
      <span>✦ Seit 2011 mit Träumen</span>
      <span>✦ Persönlich geschrieben</span>
      <span>✦ Vertraulich</span>
    </div>
  </div>

  {/* ══════════ OFFER ══════════ */}
  <div class="tt-content-block" id="angebot">
    <div class="tt-rune-divider" style="max-width: 100%; margin: 0 0 2.5rem; padding: 0;">
      <span class="tt-runes">᚛ ✦ ᚜</span>
    </div>
    <div class="tt-offer-wrap">
      <div class="tt-offer-box">
        <p class="tt-offer-title">Persönliche Traumdeutung</p>
        <p class="tt-offer-limited">✦ Einführungsangebot ✦</p>
        <div class="tt-price-row">
          <span class="tt-price-was">€69</span>
          <span class="tt-price-now">€29</span>
        </div>
        <p class="tt-price-note">Normalpreis €69 · Einführungspreis für kurze Zeit</p>
        <p class="tt-offer-desc">
          Ein Traum. Vollständig gedeutet. Schriftlich zugestellt.<br />
          Persönlich verfasst — nach der Aisling-Methode.
        </p>
        <ul class="tt-offer-features">
          <li>Vollständige Analyse aller Symbole und ihrer Verbindungen</li>
          <li>Klare Aussage über das Kernthema deines Traumes</li>
          <li>Hinweise auf Handlungsschritte oder Aufmerksamkeitsbereiche</li>
          <li>Schriftliche Lieferung — zum Aufbewahren und Nachdenken</li>
          <li>Vertraulich behandelt — dein Traum bleibt dein Traum</li>
        </ul>
        <div class="tt-pwyc">
          <h4 class="tt-pwyc-title">Wenn der Preis gerade nicht passt</h4>
          <p>
            Diese Arbeit soll an niemandem am Geld scheitern. Wenn dir eine Deutung
            wichtig ist, der Preis aber im Moment nicht möglich ist, schreib mir einfach.
            Wir finden eine Lösung, die für dich stimmt — ohne Erklärung, ohne Umstände.
          </p>
        </div>
        <p class="tt-offer-desc" style="margin-top: 1.5rem;">
          Klientinnen und Klienten aus Österreich und der Schweiz sind ausdrücklich
          willkommen. Die Zahlung läuft unkompliziert über einen Zahlungslink — auch
          aus der Schweiz, ohne dass du dich um die Währung kümmern musst.
        </p>
        <p class="tt-offer-notice">
          <strong>Wichtiger Hinweis:</strong> Die Traumdeutung ist eine reflektierende
          Dienstleistung nach der Aisling-Methode. Sie ist keine medizinische,
          psychotherapeutische oder psychologische Beratung und ersetzt keine solche.
          Details in den <a href="/agb">AGB § 2a</a>.
        </p>
        <CtaButtons tone="light" center={true} />
        <p class="tt-cta-subline" style="text-align: center; margin-top: 1rem;">
