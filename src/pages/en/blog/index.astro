---
import BlogIndex from '../../../layouts/BlogIndex.astro';
import { getCollection } from 'astro:content';
import { pairs } from '../../../i18n/ui';

const posts = (await getCollection('blogEn', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<BlogIndex
  lang="en"
  title="Blog — Traumtheater"
  description="Articles on dream interpretation with the Aisling Method: what dreams mean, how to remember them and what they say about where you are in your life."
  path="/en/blog"
  alternates={pairs.blog}
  heading="Blog"
  intro="Thoughts on dream interpretation with the Aisling Method: practical, without jargon, for anyone who wants to take their dreams seriously."
  posts={posts}
  postBase="/en/blog"
/>
