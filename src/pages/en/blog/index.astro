---
import BlogIndex from '../../../layouts/BlogIndex.astro';
import { getCollection } from 'astro:content';
import { pairs } from '../../../i18n/ui';

const posts = (await getCollection('blogEn', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<BlogIndex
  lang="en"
  title="Blog: Dream Interpretation with the Aisling Method"
  description="Articles on dream interpretation with the Aisling Method: what dreams mean, how to remember them and what they say about where you are in your life."
  path="/en/blog"
  alternates={pairs.blog}
  heading="Blog"
  intro="Thoughts on dream interpretation with the Aisling Method: practical, without jargon, for anyone who wants to take their dreams seriously. Here I write about what comes up again and again in my work with dreams: how you actually remember them, why a single symbol rarely has one fixed meaning, and what a dream can show about where you are in your life. Not a dictionary to look things up in, but background on how I actually work through an interpretation. If you have a dream you'd like to understand better after reading, you can send it to me any time."
  posts={posts}
  postBase="/en/blog"
/>
