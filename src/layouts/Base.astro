---
import '../styles/global.css';
import {
  useTranslations,
  ogLocale,
  homePath,
  site,
  type Lang,
  type Alternates,
} from '../i18n/ui';

export interface Props {
  title: string;
  description: string;
  ogTitle?: string;
  ogDescription?: string;
  /** Path only, e.g. "/impressum". Canonical is built from astro.config `site`. */
  path?: string;
  /** Extra JSON-LD blocks to inject into <head>. */
  jsonLd?: unknown[];
  noindex?: boolean;
  lang?: Lang;
  /**
   * Both language versions of this page. Emits reciprocal hreflang and points
   * the language switcher at the counterpart. Omit for pages that exist in one
   * language only (the legal pages) — then no hreflang is claimed, which is
   * what we want, since Google drops hreflang that does not point back.
   */
  alternates?: Alternates;
}

const {
  title,
  description,
  ogTitle,
  ogDescription,
  path = '/',
  jsonLd = [],
  noindex = false,
  lang = 'de',
  alternates,
} = Astro.props;

const t = useTranslations(lang);

/**
 * Every URL we advertise must be the exact one the server returns 200 for.
 *
 * The build uses `format: 'directory'`, so a page lives at `/agb/index.html`
 * and Netlify 301s `/agb` to `/agb/`. The sitemap already lists the slash form.
 * Canonical, hreflang and og:url were being built from the slashless path, so
 * every page pointed its canonical at a URL that redirects. Google reported
 * "Page with redirect" and "Alternate page with proper canonical tag" against
 * those URLs and started dropping them, which is what collapsed impressions in
 * August 2026. Do not remove this.
 */
const withSlash = (p: string) => (p.endsWith('/') ? p : `${p}/`);
const abs = (p: string) => new URL(withSlash(p), site).href;

const canonical = abs(path);
const ogImage = `${site}/assets/logo.png`;

const otherLang: Lang = lang === 'de' ? 'en' : 'de';
// With no counterpart, the switcher still works: it lands on the other
// language's homepage rather than disappearing.
const switchHref = withSlash(alternates ? alternates[otherLang] : homePath[otherLang]);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#1a0e04" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Traumtheater" />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow'} />
    <link rel="canonical" href={canonical} />

    {alternates && (
      <>
        <link rel="alternate" hreflang="de" href={abs(alternates.de)} />
        <link rel="alternate" hreflang="en" href={abs(alternates.en)} />
        {/* German is the primary market, so it takes x-default. */}
        <link rel="alternate" hreflang="x-default" href={abs(alternates.de)} />
      </>
    )}

    <meta property="og:type" content="website" />
    <meta property="og:locale" content={ogLocale[lang]} />
    {alternates && <meta property="og:locale:alternate" content={ogLocale[otherLang]} />}
    <meta property="og:site_name" content="Traumtheater" />
    <meta property="og:title" content={ogTitle ?? title} />
    <meta property="og:description" content={ogDescription ?? description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={canonical} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle ?? title} />
    <meta name="twitter:description" content={ogDescription ?? description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" type="image/png" href="/assets/logo.png" />
    <link rel="apple-touch-icon" href="/assets/logo.png" />

    <!-- Self-hosted; no third-party font request. -->
    <link rel="preload" href="/assets/fonts/source-sans-3-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="/assets/fonts/fonts.css" />

    {jsonLd.map((block) => (
      <script type="application/ld+json" set:html={JSON.stringify(block)} />
    ))}

    <style is:global>
      html, body { margin: 0; padding: 0; background: #e8d5a8; }
    </style>
  </head>

  <body>
    <div class="tt-root" data-variant="editorial">
      <nav class="tt-nav" data-open="false" id="tt-nav">
        <a href={t.navBrandHref} class="tt-nav-brand">Traumtheater</a>
        <button
          class="tt-nav-toggle"
          aria-label={t.menuOpen}
          aria-expanded="false"
          id="tt-nav-toggle"
          data-label-open={t.menuOpen}
          data-label-close={t.menuClose}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <path d="M4 7h16" /><path d="M4 12h16" /><path d="M4 17h16" />
          </svg>
        </button>
        <div class="tt-nav-links" id="tt-nav-links">
          {t.nav.map((l) => <a href={l.href}>{l.label}</a>)}
          <a href={t.navCtaHref} class="tt-nav-cta">{t.navCta}</a>
          <a href={switchHref} class="tt-nav-lang" hreflang={otherLang} lang={otherLang} aria-label={t.switchToAria}>
            {t.switchTo}
          </a>
        </div>
      </nav>

      <slot />

      <footer class="tt-footer">
        <nav class="tt-footer-links tt-footer-links--service">
          {t.footerService.map((l) => <a href={l.href}>{l.label}</a>)}
        </nav>
        <nav class="tt-footer-links">
          {t.footerLegal.map((l) => <a href={l.href}>{l.label}</a>)}
        </nav>
        {t.footerLegalNote && <p class="tt-footer-note">{t.footerLegalNote}</p>}
        <p>{t.footerTagline}</p>
      </footer>
    </div>

    <script>
      // Progressive enhancement only — all content above is already in the HTML.
      // Menu labels come from data attributes so this stays language-agnostic.
      const nav = document.getElementById('tt-nav');
      const toggle = document.getElementById('tt-nav-toggle');
      const links = document.getElementById('tt-nav-links');

      toggle?.addEventListener('click', () => {
        const open = nav?.getAttribute('data-open') === 'true';
        nav?.setAttribute('data-open', open ? 'false' : 'true');
        toggle.setAttribute('aria-expanded', open ? 'false' : 'true');
        toggle.setAttribute(
          'aria-label',
          (open ? toggle.dataset.labelOpen : toggle.dataset.labelClose) ?? ''
        );
      });
      links?.addEventListener('click', () => {
        nav?.setAttribute('data-open', 'false');
        toggle?.setAttribute('aria-expanded', 'false');
      });

      // Testimonial carousels. All quotes are already in the HTML — this only
      // controls which one is shown, so nothing is hidden from crawlers.
      // There can be more than one on a page; each runs independently.
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      document.querySelectorAll('[data-testi]').forEach((testi) => {
        const slides = [...testi.querySelectorAll('[data-testi-slide]')];
        const dots = [...testi.querySelectorAll('[data-testi-dot]')];
        let current = 0;
        let timer = null;

        const show = (n) => {
          current = (n + slides.length) % slides.length;
          slides.forEach((s, i) => s.setAttribute('data-active', i === current ? 'true' : 'false'));
          dots.forEach((d, i) => d.setAttribute('data-active', i === current ? 'true' : 'false'));
        };

        const stop = () => { if (timer) { clearInterval(timer); timer = null; } };
        const start = () => {
          if (reduced || slides.length < 2) return;
          stop();
          timer = window.setInterval(() => show(current + 1), 15000);
        };

        dots.forEach((dot, i) =>
          dot.addEventListener('click', () => { show(i); start(); })
        );

        testi.addEventListener('mouseenter', stop);
        testi.addEventListener('mouseleave', start);
        testi.addEventListener('focusin', stop);
        testi.addEventListener('focusout', start);

        start();
      });
    </script>
  </body>
</html>
