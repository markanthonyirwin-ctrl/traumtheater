---
import Base from './Base.astro';
import CtaButtons from '../components/CtaButtons.astro';
import { useTranslations, site, type Lang, type Alternates } from '../i18n/ui';

export interface Props {
  title: string;
  description: string;
  path: string;
  h1: string;
  lead: string;
  /** Service name used in the JSON-LD for this page. */
  serviceName: string;
  /** Rendered as the visible FAQ *and* as FAQPage schema, from one source, so
   *  the two can never drift. Google requires the marked-up answer to be
   *  visible on the page. `a` may contain inline HTML. */
  faq?: { q: string; a: string }[];
  lang?: Lang;
  alternates?: Alternates;
}

const {
  title,
  description,
  path,
  h1,
  lead,
  serviceName,
  faq = [],
  lang = 'de',
  alternates,
} = Astro.props;

const t = useTranslations(lang);

const stripTags = (s: string) => s.replace(/<[^>]*>/g, '').replace(/\s+/g, ' ').trim();

// Pages pass `path` without a trailing slash, the service table carries hrefs
// with one, so a raw !== comparison never matched and every page listed itself
// under "Auch interessant". Compare normalised, and use the normalised form for
// the JSON-LD url too so schema and canonical agree (Base already normalises).
const withSlash = (p: string) => (p.endsWith('/') ? p : `${p}/`);
const canonicalPath = withSlash(path);

// The money pages cross-link to each other, within their own language.
// Whichever page is rendering drops itself from the list.
const others = t.services.filter((s) => withSlash(s.href) !== canonicalPath);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: serviceName,
    description,
    serviceType: t.serviceType,
    inLanguage: lang,
    url: `${site}${canonicalPath}`,
    provider: { '@type': 'Person', '@id': `${site}/#person`, name: 'Mark Anthony Irwin' },
    areaServed: [
      { '@type': 'Country', name: 'Germany' },
      { '@type': 'Country', name: 'Austria' },
      { '@type': 'Country', name: 'Switzerland' },
    ],
    availableLanguage: ['de', 'en'],
    offers: {
      '@type': 'Offer',
      price: '29.00',
      priceCurrency: 'EUR',
      description: t.offerDescription,
      availability: 'https://schema.org/InStock',
      url: `${site}${canonicalPath}`,
    },
  },
];

if (faq.length) {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    inLanguage: lang,
    mainEntity: faq.map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: { '@type': 'Answer', text: stripTags(item.a) },
    })),
  } as never);
}
---

<Base
  title={title}
  description={description}
  path={path}
  jsonLd={jsonLd}
  lang={lang}
  alternates={alternates}>
  <article class="tt-service">
    <header class="tt-service-header">
      <p class="tt-sec-label">{t.offerLabel}</p>
      <h1 class="tt-sec-heading">{h1}</h1>
      <p class="tt-service-lead">{lead}</p>
    </header>

    <div class="tt-service-body">
      <slot />

      {faq.length > 0 && (
        <section class="tt-faq">
          <h2>{t.faqHeading}</h2>
          {faq.map((item) => (
            <div class="tt-faq-item">
              <h3>{item.q}</h3>
              <p set:html={item.a} />
            </div>
          ))}
        </section>
      )}
    </div>

    <aside class="tt-service-cta">
      <h2>{t.ctaHeading}</h2>
      <p>{t.ctaBody}</p>
      <CtaButtons center={true} lang={lang} />
      <p class="tt-cta-subline">{t.ctaSubline}</p>
    </aside>

    <nav class="tt-service-related" aria-label={t.relatedAria}>
      <p class="tt-sec-label">{t.relatedLabel}</p>
      <ul>
        {others.map((s) => (
          <li>
            <a href={s.href}>{s.label}</a>
            <span>{s.blurb}</span>
          </li>
        ))}
        <li>
          <a href={lang === 'de' ? '/beispiel-deutung/' : '/en/example-interpretation/'}>
            {t.exampleLink}
          </a>
          <span>{t.exampleBlurb}</span>
        </li>
      </ul>
    </nav>

    <p class="tt-legal-back"><a href={lang === 'de' ? '/' : '/en'}>{t.backHome}</a></p>
  </article>
</Base>
